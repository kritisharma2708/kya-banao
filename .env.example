TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

DATABASE_URL=kya_banao.db

# === Multi-tenant (the live model) ===
# New households are set up entirely from chat: each chat runs /import_tokens
# (paste the contents of .swiggy_tokens.json from a fresh laptop OAuth) and
# /set_address (pick a default delivery address). Both are stored per chat_id
# in tenant_tokens / tenant_settings.

# === Legacy single-tenant fallback (kept for the original household) ===
# When all three are set, _migrate_legacy_tenant() seeds the per-chat tables
# for LEGACY_CHAT_ID on first boot. Idempotent — once that chat has a
# tenant_tokens row, it no-ops.
# LEGACY_CHAT_ID=-1234567890
# SWIGGY_DEFAULT_ADDRESS_ID=
# SWIGGY_TOKENS_JSON={"client_info":{...},"tokens":{...}}

# === Railway-only (leave blank locally) ===
# Point at the persistent volume so tokens + DB survive redeploys.
# SWIGGY_TOKENS_PATH=/app/data/.swiggy_tokens.json
# DATABASE_URL=/app/data/kya_banao.db
