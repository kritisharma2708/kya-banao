TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

# Default Instamart delivery address. Get the ID by running
# `python swiggy_login.py` then `python swiggy_mcp.py` to list addresses.
SWIGGY_DEFAULT_ADDRESS_ID=

DATABASE_URL=kya_banao.db

# === Railway-only (leave blank locally) ===
# Point at the persistent volume so tokens + DB survive redeploys.
# SWIGGY_TOKENS_PATH=/data/.swiggy_tokens.json
# DATABASE_URL=/data/kya_banao.db
# Bootstrap tokens once via env var; after first write to disk, the file is
# the source of truth. Re-paste after each local re-auth (every ~5 days).
# SWIGGY_TOKENS_JSON={"client_info":{...},"tokens":{...}}
